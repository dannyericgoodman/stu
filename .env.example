# ── Multi-seat production ──────────────────────────────────────────────
# JWT secret — REQUIRED in production. The server exits on boot without it
# (no fallback). Development/test without it get a random ephemeral secret.
JWT_SECRET=your-secret-key-here

# Base URL used for Stripe success/cancel redirects. Set to the public origin
# in production (https://www.stu.vc), localhost for dev.
APP_URL=https://www.stu.vc

# Stripe — founding-seat checkout ($349 one-time, 10 seats, enforced in code).
# Keys live ONLY here / in the deploy environment, never in the repo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: explicit price id if you create the product in the Stripe dashboard.
# When set, checkout uses this price instead of inline price_data.
STRIPE_FOUNDING_PRICE_ID=

# First-run owner seed. In production the seed password is RANDOM unless you set
# this; set it once, sign in, change the password in the app, then REMOVE it.
SEED_ADMIN_PASSWORD=

# SQLite file location. Default: server/data/stu.db (dev). Production should
# point at a persistent volume so redeploys don't wipe the database.
DATABASE_PATH=

# One-shot DB restore token. Set ONLY during a restore operation, then UNSET —
# while set, anyone with the token can overwrite the database.
RESTORE_TOKEN=

# Encryption-at-rest master key for user-supplied provider credentials in user_settings.
# 64-char hex (openssl rand -hex 32) preferred; any strong passphrase also works.
# If unset, credentials are stored as plaintext (dev only). Once set, new writes are
# encrypted and existing keys are migrated on the next boot. Do NOT rotate without
# re-entering keys — old ciphertext becomes undecryptable.
SETTINGS_ENC_KEY=

# Soft daily spend cap (USD) applied to non-owner users' metered LLM usage.
# The owner (admin / user_id 1) is uncapped. Default 10.
DEFAULT_DAILY_SPEND_CAP_USD=10

# Sourcing engine API keys — OWNER fallback only (lib/providerKeys). Saved
# per-user keys in Settings take precedence; non-owners with no saved key get
# null, never the platform key. The nightly scout needs Exa + Anthropic to run
# for a user; EnrichLayer powers LinkedIn enrichment; GitHub powers builder radar.
EXA_API_KEY=
ENRICHLAYER_API_KEY=
PROXYCURL_API_KEY=
HARMONIC_API_KEY=
CRUNCHBASE_API_KEY=
TWITTER_BEARER_TOKEN=
GITHUB_TOKEN=

# Notifications
SLACK_WEBHOOK_URL=

# Optional enrichment
CLEARBIT_API_KEY=

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Pipeline Configuration
PIPELINE_ENABLED=true
PIPELINE_CRON=0 6 * * *

# Notion (Strider OS) sync — fires when founder added to investment pipeline
NOTION_API_KEY=
NOTION_FOUNDERS_DB_ID=
NOTION_ASSESSMENTS_DB_ID=
STU_BASE_URL=https://stu.vc
